<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="12dp"
    android:gravity="center_vertical"
    android:background="?attr/selectableItemBackground">

    <!-- Profile Image -->
    <include
        android:id="@+id/profile_image_container"
        layout="@layout/profile_image_holder"
        android:layout_width="50dp"
        android:layout_height="50dp" />

    <!-- Member Info -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="12dp">

        <TextView
            android:id="@+id/member_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Member Name"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="?android:textColorPrimary" />

        <TextView
            android:id="@+id/member_role"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Admin"
            android:textSize="12sp"
            android:textColor="@color/lazuli"
            android:visibility="gone"
            android:layout_marginTop="2dp" />
    </LinearLayout>

    <!-- Block Button -->
    <ImageButton
        android:id="@+id/block_member_btn"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@drawable/ic_block"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Block member"
        android:padding="8dp"
        android:layout_marginEnd="4dp"
        app:tint="@color/orange"
        android:visibility="gone" />

    <!-- Remove Button -->
    <ImageButton
        android:id="@+id/remove_member_btn"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@drawable/ic_close"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Remove member"
        android:padding="8dp"
        app:tint="@color/red"
        android:visibility="gone" />

</LinearLayout>