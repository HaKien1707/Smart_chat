<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/reply_preview_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/light_gray"
    android:padding="8dp"
    android:visibility="gone">

    <!-- Header with "Replying to message" and close button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Replying to message"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/violet" />

        <ImageButton
            android:id="@+id/cancel_reply_btn"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_close"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Cancel reply"
            app:tint="@color/gray" />
    </LinearLayout>

    <!-- Vertical line indicator -->
    <View
        android:layout_width="3dp"
        android:layout_height="0dp"
        android:layout_marginStart="8dp"
        android:layout_marginTop="4dp"
        android:background="@color/violet" />

    <!-- Reply content container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="4dp"
        android:paddingStart="12dp"
        android:paddingEnd="8dp">

        <!-- Vertical line -->
        <View
            android:layout_width="3dp"
            android:layout_height="match_parent"
            android:background="@color/violet"
            android:layout_marginEnd="8dp" />

        <!-- Text content -->
        <LinearLayout
            android:id="@+id/reply_text_container"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/reply_sender_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sender Name"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/violet"
                android:visibility="gone" />

            <TextView
                android:id="@+id/reply_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Message text preview"
                android:textSize="14sp"
                android:textColor="@color/black"
                android:maxLines="2"
                android:ellipsize="end" />
        </LinearLayout>

        <!-- Image preview -->
        <ImageView
            android:id="@+id/reply_image"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:scaleType="centerCrop"
            android:visibility="gone"
            android:contentDescription="Reply image preview" />
    </LinearLayout>

</LinearLayout>