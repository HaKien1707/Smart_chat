<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/popup_background"
    android:padding="6dp">

    <!-- Reply Option -->
    <LinearLayout
        android:id="@+id/option_reply_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="?attr/selectableItemBackground"
        android:paddingStart="10dp"
        android:paddingEnd="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_reply"
            app:tint="@color/popup_icon_tint"
            android:contentDescription="Reply" />

        <TextView
            android:id="@+id/option_reply"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="Reply"
            android:textSize="16sp"
            android:textColor="?android:textColorPrimary" />
    </LinearLayout>

    <View
        android:id="@+id/divider_reply"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/popup_divider" />

    <!-- Forward Option -->
    <LinearLayout
        android:id="@+id/option_forward_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="?attr/selectableItemBackground"
        android:paddingStart="10dp"
        android:paddingEnd="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_forward"
            app:tint="@color/popup_icon_tint"
            android:contentDescription="Forward" />

        <TextView
            android:id="@+id/option_forward"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="Forward"
            android:textSize="16sp"
            android:textColor="?android:textColorPrimary" />
    </LinearLayout>

    <View
        android:id="@+id/divider_forward"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/popup_divider" />

    <!-- Delete Option -->
    <LinearLayout
        android:id="@+id/option_delete_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="?attr/selectableItemBackground"
        android:paddingStart="10dp"
        android:paddingEnd="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_delete"
            app:tint="@color/red"
            android:contentDescription="Delete" />

        <TextView
            android:id="@+id/option_delete"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="Delete"
            android:textSize="16sp"
            android:textColor="@color/red" />
    </LinearLayout>

</LinearLayout>