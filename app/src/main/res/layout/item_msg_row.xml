<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="6dp">

    <!-- Sender bubble (from others) - LEFT SIDE -->
    <LinearLayout
        android:id="@+id/sender"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="start"
        android:padding="8dp"
        android:visibility="gone">

        <!-- Optional avatar (can add later) -->

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginStart="8dp">

            <!-- Replied message -->
            <include
                android:id="@+id/sender_replied_message"
                layout="@layout/layout_replied_message"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <!-- Message bubble -->
            <FrameLayout
                android:id="@+id/senderMessageContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/input_box"
                android:backgroundTint="@color/lime"
                android:padding="10dp"
                android:layout_margin="5dp">

                <TextView
                    android:id="@+id/senderMsg"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxWidth="250dp"
                    android:textSize="18sp"
                    android:textColor="@color/black"
                    android:visibility="gone"/>

                <ImageView
                    android:id="@+id/senderImage"
                    android:layout_width="200dp"
                    android:layout_height="200dp"
                    android:scaleType="centerCrop"
                    android:visibility="gone"/>
            </FrameLayout>

            <!-- Timestamp -->
            <TextView
                android:id="@+id/senderTimestamp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:textColor="#808080"
                android:layout_marginStart="10dp"
                android:text="10:30 AM"/>
        </LinearLayout>
    </LinearLayout>

    <!-- Receiver bubble (your messages) - RIGHT SIDE -->
    <LinearLayout
        android:id="@+id/receiver"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end"
        android:padding="8dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginEnd="8dp">

            <!-- Replied message -->
            <include
                android:id="@+id/receiver_replied_message"
                layout="@layout/layout_replied_message"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <!-- Message bubble -->
            <FrameLayout
                android:id="@+id/receiverMessageContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/input_box"
                android:backgroundTint="@color/violet"
                android:padding="10dp"
                android:layout_margin="5dp">

                <TextView
                    android:id="@+id/receiverMsg"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="18sp"
                    android:textColor="@color/white"
                    android:maxWidth="250dp"
                    android:visibility="gone"/>

                <ImageView
                    android:id="@+id/receiverImage"
                    android:layout_width="200dp"
                    android:layout_height="200dp"
                    android:scaleType="centerCrop"
                    android:visibility="gone"/>
            </FrameLayout>

            <!-- Timestamp + read status -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_gravity="end"
                android:layout_marginTop="2dp">

                <TextView
                    android:id="@+id/receiverTimestamp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="11sp"
                    android:textColor="#808080"
                    android:layout_marginEnd="4dp"
                    android:text="10:30 AM"/>

                <ImageView
                    android:id="@+id/readStatusIcon"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_message_sent"/>
            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</LinearLayout>