<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="6dp">

    <!-- Date separator (Telegram-like) -->
    <TextView
        android:id="@+id/dateHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="6dp"
        android:textColor="?android:textColorSecondary"
        android:textSize="12sp"
        android:visibility="gone" />

    <!-- Sender bubble (from others) - LEFT SIDE -->
    <LinearLayout
        android:id="@+id/sender"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="start"
        android:padding="8dp"
        android:visibility="gone">

        <!-- Optional avatar (can add later) -->

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginStart="8dp">

            <!-- Replied message -->
            <include
                android:id="@+id/sender_replied_message"
                layout="@layout/layout_replied_message"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <!-- Message bubble -->
            <FrameLayout
                android:id="@+id/senderMessageContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/chat_bubble"
                android:backgroundTint="@color/chat_bubble_other_bg"
                android:padding="10dp"
                android:layout_margin="5dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Message body with optional overlay timestamp -->
                    <FrameLayout
                        android:id="@+id/senderBody"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">

                        <TextView
                            android:id="@+id/senderMsg"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="18sp"
                            android:textColor="@color/chat_bubble_other_text"
                            android:visibility="gone" />

                        <ImageView
                            android:id="@+id/senderImage"
                            android:layout_width="200dp"
                            android:layout_height="200dp"
                            android:scaleType="centerCrop"
                            android:visibility="gone" />

                        <!-- Timestamp overlay (inline for short messages) -->
                        <TextView
                            android:id="@+id/senderTimestampOverlay"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="end|bottom"
                            android:textSize="11sp"
                            android:textColor="@color/chat_bubble_meta_text"
                            android:text="10:30 AM"
                            android:visibility="gone" />

                    </FrameLayout>

                    <!-- Timestamp below (default for long messages) -->
                    <TextView
                        android:id="@+id/senderTimestamp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end"
                        android:textSize="11sp"
                        android:textColor="@color/chat_bubble_meta_text"
                        android:text="10:30 AM" />

                </LinearLayout>
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Receiver bubble (your messages) - RIGHT SIDE -->
    <LinearLayout
        android:id="@+id/receiver"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end"
        android:padding="8dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginEnd="8dp">

            <!-- Replied message -->
            <include
                android:id="@+id/receiver_replied_message"
                layout="@layout/layout_replied_message"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <!-- Message bubble -->
            <FrameLayout
                android:id="@+id/receiverMessageContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/chat_bubble"
                android:backgroundTint="@color/chat_bubble_me_bg"
                android:padding="10dp"
                android:layout_margin="5dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Message body with optional overlay meta -->
                    <FrameLayout
                        android:id="@+id/receiverBody"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">

                        <TextView
                            android:id="@+id/receiverMsg"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="18sp"
                            android:textColor="@color/chat_bubble_me_text"
                            android:visibility="gone" />

                        <ImageView
                            android:id="@+id/receiverImage"
                            android:layout_width="200dp"
                            android:layout_height="200dp"
                            android:scaleType="centerCrop"
                            android:visibility="gone" />

                        <!-- Meta overlay (inline for short messages) -->
                        <LinearLayout
                            android:id="@+id/receiverMetaOverlay"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="end|bottom"
                            android:orientation="horizontal"
                            android:visibility="gone">

                            <TextView
                                android:id="@+id/receiverTimestampOverlay"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="11sp"
                                android:textColor="@color/chat_bubble_meta_text"
                                android:layout_marginEnd="4dp"
                                android:text="10:30 AM" />

                            <ImageView
                                android:id="@+id/readStatusIconOverlay"
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:src="@drawable/ic_message_sent" />

                        </LinearLayout>

                    </FrameLayout>

                    <!-- Meta below (default for long messages) -->
                    <LinearLayout
                        android:id="@+id/receiverMetaBelow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/receiverTimestamp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="11sp"
                            android:textColor="@color/chat_bubble_meta_text"
                            android:layout_marginEnd="4dp"
                            android:text="10:30 AM" />

                        <ImageView
                            android:id="@+id/readStatusIcon"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_message_sent" />

                    </LinearLayout>

                </LinearLayout>
            </FrameLayout>
        </LinearLayout>

    </LinearLayout>

</LinearLayout>