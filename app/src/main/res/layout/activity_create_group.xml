<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".activities.CreateGroupActivity">

    <!-- Top Panel -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/lazuli"
        android:padding="10dp">

        <ImageButton
            android:id="@+id/back_btn"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="@drawable/ic_back"
            android:contentDescription="@string/backBTN" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="@string/createGroup"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/black" />
    </RelativeLayout>

    <!-- Group Info Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:background="@color/lazuli">

        <!-- Group Image -->
        <ImageView
            android:id="@+id/group_image"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_group"
            android:scaleType="centerCrop"
            android:background="@drawable/circle_bg"
            android:padding="20dp"
            android:contentDescription="Group image" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="@string/tapToChange"
            android:textSize="12sp"
            android:layout_marginTop="5dp"
            android:textColor="@android:color/black" />

        <!-- Group Name Input -->
        <EditText
            android:id="@+id/group_name_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="?attr/inputBoxBackground"
            android:textColor="?attr/editTextColor"
            android:textColorHint="?android:textColorSecondary"
            android:hint="@string/enterGroupName"
            android:padding="15dp"
            android:textSize="18sp"
            android:inputType="text"
            android:maxLines="1" />
    </LinearLayout>

    <!-- Members Section -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/minMember"
        android:textSize="16sp"
        android:textStyle="bold"
        android:padding="15dp"
        android:textColor="@color/black" />

    <!-- Member List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/member_recycler"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="10dp" />

    <!-- Create Button -->
    <Button
        android:id="@+id/create_btn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="15dp"
        android:background="@drawable/round_corner_button"
        android:text="@string/minMember"
        android:textSize="16sp"
        android:padding="15dp"
        android:enabled="false" />

</LinearLayout>