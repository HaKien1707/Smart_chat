<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="12dp"
    android:background="?attr/selectableItemBackground">

    <!-- Profile Image -->
    <include
        android:id="@+id/profile_image_container"
        layout="@layout/profile_image_holder"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_alignParentStart="true"
        android:layout_centerVertical="true" />

    <!-- Member Info -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_toEndOf="@id/profile_image_container"
        android:layout_toStartOf="@id/owner_label"
        android:layout_centerVertical="true"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/member_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Member Name"
            android:textSize="16sp"
            android:textColor="?android:textColorPrimary"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/member_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="last seen recently"
            android:textSize="14sp"
            android:textColor="?android:textColorSecondary"
            android:layout_marginTop="2dp"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <!-- Owner Label -->
    <TextView
        android:id="@+id/owner_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_centerVertical="true"
        android:layout_marginEnd="48dp"
        android:text="Owner"
        android:textSize="14sp"
        android:textColor="@color/button_green"
        android:visibility="gone" />

    <!-- Options Button (3 dots) -->
    <ImageButton
        android:id="@+id/member_options_btn"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_alignParentEnd="true"
        android:layout_centerVertical="true"
        android:src="@drawable/ic_more_vert_24"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Member options"
        android:padding="8dp"
        android:tint="?android:textColorSecondary"
        android:visibility="gone" />

</RelativeLayout>
