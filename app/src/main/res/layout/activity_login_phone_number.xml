<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/lazuli"
    android:fillViewport="true"
    tools:context=".activities.login.LoginPhoneNumberActivity">

    <LinearLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <!-- Back -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="16dp">

            <ImageButton
                android:id="@+id/back_btn"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@android:color/transparent"
                android:contentDescription="Back"
                android:src="@drawable/ic_arrow_back_24" />
        </FrameLayout>

        <!-- Icon -->
        <ImageView
            android:id="@+id/icon"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:background="@drawable/ic_phone"
            android:layout_marginTop="40dp"
            android:contentDescription="Phone Icon"/>

        <!-- Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/loginPhoneNumber"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:layout_marginTop="20dp"/>

        <!-- Phone Number Section -->
        <LinearLayout
            android:id="@+id/phoneNumberSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="40dp"
            android:layout_marginHorizontal="20dp"
            android:gravity="center_vertical">

            <com.hbb20.CountryCodePicker
                android:id="@+id/codePicker"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:ccp_showNameCode="false"
                app:ccp_showFlag="true"
                android:layout_margin="5dp"/>

            <EditText
                android:id="@+id/inputPhoneNumber"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_margin="5dp"
                android:background="?attr/inputBoxBackground"
                android:textColor="?attr/editTextColor"
                android:textColorHint="?android:textColorSecondary"
                android:elevation="10dp"
                android:inputType="phone"
                android:hint="@string/enter_phone_num"
                android:padding="15dp"
                android:textSize="18sp"/>
        </LinearLayout>

        <!-- Progress Bar -->
        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginTop="20dp"
            android:visibility="gone"/>

        <!-- Send OTP Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/send_OTP_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:text="@string/sendOTP"
            android:paddingHorizontal="32dp"
            android:paddingVertical="12dp"/>

        <!-- Spacer to push page indicator down -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="50dp"/>

        <!-- Page Indicator -->
        <LinearLayout
            android:id="@+id/pageNumber"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="40dp"
            android:gravity="center"
            android:orientation="horizontal">

            <RelativeLayout
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_margin="8dp"
                android:background="@drawable/circle_bg"
                android:backgroundTint="@color/green"/>

            <RelativeLayout
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_margin="8dp"
                android:background="@drawable/circle_bg"
                android:backgroundTint="@color/gray"/>

            <RelativeLayout
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_margin="8dp"
                android:background="@drawable/circle_bg"
                android:backgroundTint="@color/gray"/>
        </LinearLayout>

    </LinearLayout>
</ScrollView>