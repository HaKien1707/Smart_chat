<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:padding="6dp">

    <!-- Sender bubble (from others) - LEFT SIDE -->
    <LinearLayout
        android:id="@+id/sender"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Profile Image -->
        <ImageView
            android:id="@+id/senderProfileImage"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="8dp"
            android:layout_gravity="bottom"
            android:src="@drawable/ic_profile"
            android:background="@drawable/circle_bg"
            android:scaleType="centerCrop"
            android:contentDescription="Sender profile" />

        <!-- Message Container -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Sender Name -->
            <TextView
                android:id="@+id/senderName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="John Doe"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="?android:textColorPrimary"
                android:layout_marginStart="4dp"
                android:layout_marginBottom="2dp" />

            <!-- Container for message -->
            <FrameLayout
                android:id="@+id/senderMessageContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/input_box"
                android:backgroundTint="@color/lime"
                android:padding="10dp"
                android:layout_margin="5dp">

                <!-- Message Text -->
                <TextView
                    android:id="@+id/senderMsg"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/black"
                    android:textSize="18sp"
                    android:maxWidth="250dp"
                    android:visibility="gone" />

                <!-- Image for sender -->
                <ImageView
                    android:id="@+id/senderImage"
                    android:layout_width="200dp"
                    android:layout_height="200dp"
                    android:scaleType="centerCrop"
                    android:visibility="gone"
                    android:contentDescription="Sent image" />
            </FrameLayout>

            <!-- Timestamp -->
            <TextView
                android:id="@+id/senderTimestamp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:textColor="#808080"
                android:layout_marginStart="10dp"
                android:layout_marginTop="2dp"
                android:text="10:30 AM" />
        </LinearLayout>
    </LinearLayout>

    <!-- Receiver bubble (your messages) - RIGHT SIDE -->
    <LinearLayout
        android:id="@+id/receiver"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Container for message -->
        <FrameLayout
            android:id="@+id/receiverMessageContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/input_box"
            android:backgroundTint="@color/violet"
            android:padding="10dp"
            android:layout_margin="5dp">

            <!-- Your messages text -->
            <TextView
                android:id="@+id/receiverMsg"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:maxWidth="250dp"
                android:visibility="gone" />

            <!-- Image for receiver -->
            <ImageView
                android:id="@+id/receiverImage"
                android:layout_width="200dp"
                android:layout_height="200dp"
                android:scaleType="centerCrop"
                android:visibility="gone"
                android:contentDescription="Received image" />
        </FrameLayout>

        <!-- Timestamp -->
        <TextView
            android:id="@+id/receiverTimestamp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:textColor="#808080"
            android:layout_marginEnd="10dp"
            android:layout_marginTop="2dp"
            android:layout_gravity="end"
            android:text="10:30 AM" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>