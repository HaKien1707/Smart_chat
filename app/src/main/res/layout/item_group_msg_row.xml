<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="6dp">

    <!-- Sender bubble (from others) - LEFT SIDE -->
    <LinearLayout
        android:id="@+id/sender"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="start"
        android:padding="8dp"
        android:visibility="gone">

        <!-- Profile Image -->
        <ImageView
            android:id="@+id/senderProfileImage"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="8dp"
            android:layout_gravity="bottom"
            android:src="@drawable/ic_profile"
            android:background="@drawable/circle_bg"
            android:scaleType="centerCrop"
            android:contentDescription="Sender profile" />

        <!-- Message column -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Sender name -->
            <TextView
                android:id="@+id/senderName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="?android:textColorPrimary"
                android:layout_marginStart="4dp"
                android:layout_marginBottom="2dp" />

            <!-- Replied message -->
            <include
                android:id="@+id/sender_replied_message"
                layout="@layout/layout_replied_message"
                android:visibility="gone" />

            <!-- Message bubble -->
            <FrameLayout
                android:id="@+id/senderMessageContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/input_box"
                android:backgroundTint="@color/lime"
                android:padding="10dp"
                android:layout_margin="5dp">

                <TextView
                    android:id="@+id/senderMsg"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxWidth="250dp"
                    android:textSize="18sp"
                    android:textColor="@color/black"
                    android:visibility="gone"/>

                <ImageView
                    android:id="@+id/senderImage"
                    android:layout_width="200dp"
                    android:layout_height="200dp"
                    android:scaleType="centerCrop"
                    android:visibility="gone"/>
            </FrameLayout>

            <!-- Timestamp -->
            <TextView
                android:id="@+id/senderTimestamp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:textColor="#808080"
                android:layout_marginStart="10dp"
                android:text="10:30 AM"/>
        </LinearLayout>
    </LinearLayout>

    <!-- Receiver bubble (your messages) - RIGHT SIDE -->
    <LinearLayout
        android:id="@+id/receiver"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end"
        android:padding="8dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginEnd="8dp">

            <!-- 🔁 Replied message -->
            <include
                android:id="@+id/receiver_replied_message"
                layout="@layout/layout_replied_message"
                android:visibility="gone" />

            <!-- Message bubble -->
            <FrameLayout
                android:id="@+id/receiverMessageContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/input_box"
                android:backgroundTint="@color/violet"
                android:padding="10dp"
                android:layout_margin="5dp">

                <TextView
                    android:id="@+id/receiverMsg"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="18sp"
                    android:textColor="@color/white"
                    android:maxWidth="250dp"
                    android:visibility="gone"/>

                <ImageView
                    android:id="@+id/receiverImage"
                    android:layout_width="200dp"
                    android:layout_height="200dp"
                    android:scaleType="centerCrop"
                    android:visibility="gone"/>
            </FrameLayout>

            <!-- Timestamp -->
            <TextView
                android:id="@+id/receiverTimestamp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:textColor="#808080"
                android:layout_gravity="end"
                android:text="10:30 AM"/>
        </LinearLayout>
    </LinearLayout>


</LinearLayout>