<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base Dark Theme -->
    <style name="Theme.SmartChat" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color -->
        <item name="colorPrimary">@color/lazuli</item>
        <item name="colorPrimaryVariant">@color/lazuli</item>
        <item name="colorOnPrimary">@color/white</item>

        <!-- Background colors -->
        <item name="android:windowBackground">@color/background_dark</item>
        <item name="backgroundColor">@color/background_dark</item>
        <item name="cardBackgroundColor">@color/card_background_dark</item>

        <!-- Text colors -->
        <item name="android:textColorPrimary">@color/text_primary_dark</item>
        <item name="android:textColorSecondary">@color/text_secondary_dark</item>

        <!-- EditText colors -->
        <item name="editTextColor">@color/text_primary_dark</item>
        <item name="android:editTextColor">@color/text_primary_dark</item>
        <item name="android:textColorHint">@color/text_secondary_dark</item>

        <!-- Status bar -->
        <item name="android:statusBarColor">@color/lazuli</item>

        <!-- Custom attributes -->
        <item name="inputBoxBackground">@drawable/input_box_dark</item>
    </style>
</resources>