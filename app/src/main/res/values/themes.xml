<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme -->
    <style name="Base.Theme.Smart_Chat" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="colorPrimary">@color/lazuli</item>
        <item name="colorPrimaryVariant">@color/lazuli</item>
        <item name="colorOnPrimary">@color/white</item>
    </style>

    <style name="Theme.Smart_Chat" parent="Base.Theme.Smart_Chat" />

    <style name="Theme.Smart_Chat.Fullscreen" parent="Theme.Smart_Chat">
        <item name="android:actionBarStyle">@style/Widget.Theme.Smart_Chat.ActionBar.Fullscreen
        </item>
        <item name="android:windowActionBarOverlay">true</item>
        <item name="android:windowBackground">@null</item>
    </style>

    <style name="ThemeOverlay.Chat_java.FullscreenContainer" parent="">
        <item name="fullscreenBackgroundColor">@color/light_blue_600</item>
        <item name="fullscreenTextColor">@color/light_blue_A200</item>
    </style>
</resources>